{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/examples/database-demo",
      "destination": "/examples/database-demo/index.html"
    },
    {
      "source": "/examples/database-demo/((?!assets(?:/|$)).*)",
      "destination": "/examples/database-demo/index.html"
    },
    {
      "source": "/((?!api(?:/|$)|examples/database-demo(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}

