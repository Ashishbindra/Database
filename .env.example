# Environment Variable Declarations for GitHub Encrypted Storage SDK
# Note: Do NOT expose GITHUB_STORAGE_PAT to client side Vite variables!

# Optional GitHub Personal Access Token or GitHub App Installation secret (Server-Only)
GITHUB_STORAGE_PAT=
GITHUB_OWNER=Ashishbindra
GITHUB_REPO=github-encrypted-storage
GITHUB_BRANCH=main

# Secret key for server-side HMAC-SHA256 Session signing
SESSION_SECRET=
